# Copie para .env.local (desenvolvimento) ou cadastre em Settings > Environment Variables (Vercel).
# Todos os valores são opcionais: sem eles o sistema usa o projeto Firebase "erp-igrejaadventista".

# Dados: "firebase" (padrão, sincroniza na nuvem) ou "local" (somente neste aparelho).
# VITE_DATA_BACKEND=firebase

# Contas de demonstração na tela de login e "Testar outro perfil". Use "false" antes de cadastrar dados reais.
# VITE_DEMO_MODE=true

# Pasta da igreja no Firestore: igrejas/<tenant>/<coleção>. Outro valor cria um ambiente separado (testes).
# VITE_FIREBASE_TENANT=iasd-706-sul

# Configuração do app web no Firebase (Configurações do projeto > Seus apps).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
