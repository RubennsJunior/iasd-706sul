# Copie para .env.local (desenvolvimento) ou cadastre em Settings > Environment Variables (Vercel).
# Todos os valores são opcionais: sem eles o sistema usa o projeto Firebase "erp-igrejaadventista".

# Dados: "firebase" (padrão, sincroniza na nuvem) ou "local" (somente neste aparelho).
# VITE_DATA_BACKEND=firebase

# Só no modo local (VITE_DATA_BACKEND=local): contas de demonstração na tela de login e "Testar outro perfil".
# VITE_DEMO_MODE=true

# E-mail do primeiro administrador (conta criada no Firebase Authentication). Tem de ser o mesmo de firestore.rules.
# VITE_ADMIN_EMAIL=admin@admin.com

# Emuladores locais do Firebase (Firestore e Authentication), para testar sem tocar no projeto real.
# VITE_FIREBASE_EMULATOR=1
# VITE_FIREBASE_PROJECT_ID=demo-igreja

# Pasta da igreja no Firestore: igrejas/<tenant>/<coleção>. Outro valor cria um ambiente separado (testes).
# VITE_FIREBASE_TENANT=iasd-706-sul

# Notificações no aparelho (veja o README, "Notificações no aparelho (push)").
# SERVIDOR — cadastre na Vercel (Settings > Environment Variables), nunca no repositório:
#   FIREBASE_SERVICE_ACCOUNT=<todo o conteúdo do .json da conta de serviço do Firebase>
#   FIREBASE_SERVICE_ACCOUNT_BASE64=<o mesmo conteúdo em base64, se preferir>
#   FIREBASE_TENANT=iasd-706-sul
#   PUSH_SUBJECT=https://iasd-706sul.vercel.app
# APLICATIVO — só para apontar para outra função de envio (padrão: /api/push, e no APK o endereço do site):
# VITE_PUSH_API=

# Configuração do app web no Firebase (Configurações do projeto > Seus apps).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
